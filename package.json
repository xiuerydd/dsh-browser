{
  "name": "dsh-browser",
  "productName": "DeepSeek Harness Browser",
  "version": "0.1.0-rc.6",
  "description": "仅为 DeepSeek Harness 打造的专用桌面浏览器壳",
  "type": "module",
  "main": "src/main.js",
  "license": "MIT",
  "author": "dsh-browser contributors",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist": "electron-builder --win nsis",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1"
  },
  "build": {
    "appId": "com.deepseek.dsh-browser",
    "productName": "DeepSeek Harness Browser",
    "copyright": "DSH Browser",
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules",
        "to": "dsh-runtime/node_modules",
        "filter": [
          "**/*",
          "!**/.bin/**",
          "!**/.package-lock.json",
          "!electron/**",
          "!electron-builder/**",
          "!app-builder-lib/**",
          "!app-builder-bin/**",
          "!builder-util/**",
          "!builder-util-runtime/**",
          "!dmg-builder/**",
          "!@electron/**",
          "!@electron-internal/**",
          "!@malept/**"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icons/dsh-browser.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness Browser"
    }
  }
}
